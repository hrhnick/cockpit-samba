{
  "name": "samba",
  "version": "2.0.6",
  "description": "Samba file sharing manager for Cockpit",
  "type": "module",
  "main": "index.tsx",
  "repository": "https://github.com/hrhnick/cockpit-samba.git",
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">= 18"
  },
  "scripts": {
    "watch": "ESBUILD_WATCH='true' ./build.js",
    "build": "./build.js",
    "test": "./test/run-unit-tests.js && ./test/run-dialog-tests.js",
    "check-patternfly": "node test/check-patternfly.js",
    "typecheck": "tsc",
    "eslint": "eslint src/ test/*.ts test/*.tsx test/*.js",
    "eslint:fix": "eslint --fix src/ test/*.ts test/*.tsx test/*.js",
    "stylelint": "stylelint src/*.{css,scss}",
    "stylelint:fix": "stylelint --fix src/*.{css,scss}"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/throttle-debounce": "5.0.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "esbuild-wasm": "0.28.1",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-config-standard-jsx": "11.0.0",
    "eslint-config-standard-react": "13.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "4.6.2",
    "jsdom": "30.0.0",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-formatter-pretty": "4.0.1",
    "stylelint-use-logical": "^2.1.3",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@patternfly/patternfly": "6.5.2",
    "@patternfly/react-core": "6.5.1",
    "@patternfly/react-icons": "6.5.1",
    "@patternfly/react-styles": "6.5.1",
    "@patternfly/react-table": "6.5.1",
    "argparse": "2.0.1",
    "dequal": "2.0.3",
    "esbuild": "0.28.1",
    "esbuild-sass-plugin": "3.7.0",
    "gettext-parser": "9.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "throttle-debounce": "5.0.2"
  }
}
