#!/usr/bin/python3 -cimport os, sys; os.execv(os.path.dirname(sys.argv[1]) + "/common/pywrap", sys.argv)

# Run this with --help to see available options for tracing and debugging
# See https://github.com/cockpit-project/cockpit/blob/main/test/common/testlib.py
# "class Browser" and "class MachineCase" for the available API.

import testlib


# Nondestructive tests all run in the same running VM. This allows them to run in Packit, Fedora, and
# RHEL dist-git gating. They must not permanently change any file or configuration on the system in a
# way that influences other tests.
@testlib.nondestructive
class TestApplication(testlib.MachineCase):
    def setUp(self):
        super().setUp()

        # The page can install Samba itself, so the module does not hard
        # depend on it; there is nothing to exercise here without it.
        if self.machine.execute("systemctl show smb smbd --property=LoadState --value").count("not-found") == 2:
            self.skipTest("Samba is not installed on this image")

        # Every test here edits smb.conf; put it back afterwards.
        self.restore_file("/etc/samba/smb.conf")
        self.machine.execute("systemctl start smb || systemctl start smbd")

    def testService(self):
        b = self.browser

        self.login_and_go("/samba")

        b.wait_in_text("#samba-service .pf-v6-c-card__title-text", "Samba server")
        b.wait_text("#samba-service-state", "Running")

        # The version and uptime are behind the card's expander; the
        # connection list lives in the Manage access dialog now
        b.click("#samba-service-toggle")
        b.wait_in_text("#samba-service", "Running since")

    def testShareLifecycle(self):
        b = self.browser
        m = self.machine

        self.addCleanup(m.execute, "rm -rf /tmp/mytestshare")

        self.login_and_go("/samba")
        b.wait_visible("#samba-share-create")

        # Create a share whose folder does not exist yet
        b.click("#samba-share-create")
        b.wait_visible("#share-dialog")
        b.set_input_text("#share-name", "mytestshare")
        b.set_input_text("#share-path", "/tmp/mytestshare")

        # The dialog notices the missing folder and offers to create it
        b.wait_visible("#share-create-folder:checked")
        b.click("#share-dialog button:contains('Create')")
        b.wait_not_present("#share-dialog")

        b.wait_in_text("#samba-shares-list", "mytestshare")
        m.execute("test -d /tmp/mytestshare")
        self.assertIn("[mytestshare]", m.execute("cat /etc/samba/smb.conf"))

        # Editing leaves parameters this page does not manage alone
        m.execute("printf '\\tmax connections = 7\\n' >> /etc/samba/smb.conf")
        b.click("#samba-shares-list tr:contains('mytestshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")
        b.set_input_text("#share-comment", "Test share")
        b.click("#share-dialog button:contains('Save')")
        b.wait_not_present("#share-dialog")

        b.wait_in_text("#samba-shares-list", "Test share")
        self.assertIn("max connections = 7", m.execute("cat /etc/samba/smb.conf"))

        # A name that differs only in case is refused, since Samba would
        # treat it as the same share
        b.click("#samba-share-create")
        b.wait_visible("#share-dialog")
        b.set_input_text("#share-name", "MyTestShare")
        b.wait_in_text("#share-dialog", "already exists")
        b.click("#share-dialog button:contains('Cancel')")
        b.wait_not_present("#share-dialog")

        # Deleting says explicitly that the folder is kept, and keeps it
        b.click("#samba-shares-list tr:contains('mytestshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Delete share')")
        b.wait_in_text(".pf-v6-c-modal-box", "not")
        b.click(".pf-v6-c-modal-box button:contains('Delete share')")
        b.wait_not_present(".pf-v6-c-modal-box")

        b.wait_not_in_text("#samba-shares-list", "mytestshare")
        self.assertNotIn("[mytestshare]", m.execute("cat /etc/samba/smb.conf"))
        m.execute("test -d /tmp/mytestshare")

    def testConfigurationIsPreserved(self):
        """Comments and unmanaged parameters survive a change made from the page"""
        b = self.browser
        m = self.machine

        m.execute("printf '\\n# a comment worth keeping\\n[keepme]\\n\\tpath = /tmp\\n"
                  "\\tvfs objects = recycle\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "keepme")

        b.click("#samba-shares-list tr:contains('keepme') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")
        b.click("#share-read-only")
        b.click("#share-dialog button:contains('Save')")
        b.wait_not_present("#share-dialog")

        config = m.execute("cat /etc/samba/smb.conf")
        self.assertIn("# a comment worth keeping", config)
        self.assertIn("vfs objects = recycle", config)

    def testGlobalSettings(self):
        b = self.browser
        m = self.machine

        m.execute("printf '\\n[globaltest]\\n\\tpath = /tmp\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "globaltest")

        b.click("#samba-service-actions")
        b.click(".pf-v6-c-menu button:contains('Global settings')")
        b.wait_visible("#global-settings-dialog")

        # The editor shows the [global] body, without its header
        self.assertNotIn("[global]", b.val("#global-settings-text"))

        b.set_input_text("#global-settings-text", "\tworkgroup = TESTGROUP\n\tserver string = test")
        b.click("#global-settings-dialog button:contains('Save')")
        b.wait_not_present("#global-settings-dialog")

        config = m.execute("cat /etc/samba/smb.conf")
        self.assertIn("workgroup = TESTGROUP", config)
        # Editing [global] leaves the shares alone
        self.assertIn("[globaltest]", config)

    def testAdvancedShareOptions(self):
        """The options behind "More options" reach smb.conf and come back"""
        b = self.browser
        m = self.machine

        m.execute("printf '\\n[optshare]\\n\\tpath = /tmp\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "optshare")

        b.click("#samba-shares-list tr:contains('optshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")

        # Turn the share off, and set the options that live behind the
        # expander
        b.click("#share-available")
        b.click("#share-dialog button:contains('More options')")
        b.wait_visible("#share-hosts-allow")
        b.set_input_text("#share-hosts-allow", "192.168.1.")
        b.set_input_text("#share-create-mask", "0664")
        b.click("#share-recycle")
        b.click("#share-dialog button:contains('Save')")
        b.wait_not_present("#share-dialog")

        config = m.execute("cat /etc/samba/smb.conf")
        self.assertIn("available = no", config)
        self.assertIn("hosts allow = 192.168.1.", config)
        self.assertIn("create mask = 0664", config)
        self.assertIn("recycle", config)
        self.assertIn("recycle:repository", config)

        # A share that is off says so in the table
        b.wait_in_text("#samba-shares-list tr:contains('optshare')", "Off")

        # An invalid mask is refused rather than written
        b.click("#samba-shares-list tr:contains('optshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")
        b.click("#share-dialog button:contains('More options')")
        b.set_input_text("#share-create-mask", "0999")
        b.wait_in_text("#share-dialog", "three or four digits")
        b.wait_visible("#share-dialog button:contains('Save'):disabled")
        b.click("#share-dialog button:contains('Cancel')")
        b.wait_not_present("#share-dialog")

    def testGuestAccessIsMadeToWork(self):
        """Allowing guests also sets map to guest, without which it does nothing"""
        b = self.browser
        m = self.machine

        m.execute("sed -i '/map to guest/d' /etc/samba/smb.conf")
        m.execute("printf '\\n[guestshare]\\n\\tpath = /tmp\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "guestshare")

        b.click("#samba-shares-list tr:contains('guestshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")
        # The dialog says it is going to do this
        b.wait_in_text("#share-dialog", "accept guest logins")
        b.click("#share-guest-ok")
        b.click("#share-dialog button:contains('Save')")
        b.wait_not_present("#share-dialog")

        config = m.execute("cat /etc/samba/smb.conf")
        self.assertIn("guest ok = yes", config)
        self.assertIn("map to guest = Bad User", config)

    def testGuestUserListConflict(self):
        """valid users gates guests too, and the page has to say so"""
        b = self.browser
        m = self.machine

        # map to guest belongs in [global]; the share below trips the trap
        m.execute(r"sed -i '/^\[global\]$/a\\tmap to guest = Bad User' /etc/samba/smb.conf")
        m.execute("printf '\\n[conflictshare]\\n\\tpath = /tmp\\n\\tguest ok = yes\\n"
                  "\\tvalid users = admin\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "conflictshare")

        # The details dialog explains the trap
        b.click("#samba-shares-list tr:contains('conflictshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('View details')")
        b.wait_visible("#share-details-dialog")
        b.wait_in_text("#share-details-dialog", "user list keeps them out")
        b.click("#share-details-dialog button:contains('Close')")
        b.wait_not_present("#share-details-dialog")

        # So does the dialog, live as the boxes change
        b.click("#samba-shares-list tr:contains('conflictshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-guest-conflict")
        b.click("#share-dialog button:contains('Cancel')")
        b.wait_not_present("#share-dialog")

    def testFixFolderPermissions(self):
        """The folder does not follow the share's user list on its own"""
        b = self.browser
        m = self.machine

        self.addCleanup(m.execute, "rm -rf /tmp/permshare")
        m.execute("mkdir -p /tmp/permshare && chown root:root /tmp/permshare")
        m.execute("printf '\\n[permshare]\\n\\tpath = /tmp/permshare\\n"
                  "\\tvalid users = admin\\n' >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "permshare")

        # The option lives in Edit share, off by default so that saving an
        # unrelated change does not take over a hand-permissioned folder
        b.click("#samba-shares-list tr:contains('permshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-fix-permissions:not(:checked)")
        b.set_checked("#share-fix-permissions", True)
        b.click("#share-dialog button:contains('Save')")
        b.wait_not_present("#share-dialog")

        self.assertEqual(m.execute("stat -c %U /tmp/permshare").strip(), "admin")

    def testSystemFolderIsRefused(self):
        """A share pointing at a system directory is not offered its permissions"""
        b = self.browser
        m = self.machine

        # /etc exists, so this exercises the guard and not the missing
        # folder path. Nothing is ever applied, so nothing is changed.
        m.execute("printf '\\n[etcshare]\\n\\tpath = /etc\\n\\tvalid users = admin\\n'"
                  " >> /etc/samba/smb.conf")

        self.login_and_go("/samba")
        b.wait_in_text("#samba-shares-list", "etcshare")

        # Editing explains the refusal and does not offer the folder's
        # permissions at all
        b.click("#samba-shares-list tr:contains('etcshare') .pf-v6-c-menu-toggle")
        b.click(".pf-v6-c-menu button:contains('Edit share')")
        b.wait_visible("#share-dialog")
        b.wait_in_text("#share-dialog", "belongs to the operating system")
        b.wait_not_present("#share-fix-permissions")

        # Pointing it somewhere ordinary brings the option back
        b.set_input_text("#share-path", "/etc/samba")
        b.wait_visible("#share-fix-permissions")
        b.wait_not_in_text("#share-dialog", "belongs to the operating system")
        b.click("#share-dialog button:contains('Cancel')")
        b.wait_not_present("#share-dialog")

        # /etc is untouched
        self.assertEqual(m.execute("stat -c '%U %a' /etc").strip(), "root 755")

    def testAccess(self):
        b = self.browser

        self.login_and_go("/samba")
        b.click("#samba-service-actions")
        b.click(".pf-v6-c-menu button:contains('Manage access')")
        b.wait_visible("#manage-access-dialog")
        b.wait_in_text("#samba-users", "admin")
        b.click("#manage-access-dialog button:contains('Close')")
        b.wait_not_present("#manage-access-dialog")


if __name__ == '__main__':
    testlib.test_main()
