Name: cockpit-samba
Version: %{VERSION}
Release: 1%{?dist}
Summary: Cockpit module for managing Samba file shares
# The project's own code is MIT; the built page bundles pkg/lib from the
# Cockpit repository, which is LGPL.
License: MIT AND LGPL-2.1-or-later

# distributions which ship nodejs-esbuild can rebuild the bundle during package build
%if 0%{?fedora} >= 42
%define rebuild_bundle 1
%endif

Source0: https://github.com/hrhnick/cockpit-samba/releases/download/%{version}/%{name}-%{version}.tar.xz
Source1: https://github.com/hrhnick/cockpit-samba/releases/download/%{version}/%{name}-node-%{version}.tar.xz

BuildArch: noarch
%if ! 0%{?suse_version}
ExclusiveArch: %{nodejs_arches} noarch
%endif
BuildRequires: make
%if 0%{?suse_version}
# Suse's package has a different name
BuildRequires: appstream-glib
%else
BuildRequires: libappstream-glib
%endif
BuildRequires: gettext
%if 0%{?rhel} && 0%{?rhel} <= 8
BuildRequires: libappstream-glib-devel
%endif
%if %{defined rebuild_bundle}
BuildRequires: /usr/bin/node
BuildRequires: nodejs-esbuild
%endif

Requires: cockpit-bridge
# samba is a hard dependency: every part of the page manages it, and
# samba-common-tools carries the tools the page runs (testparm,
# smbpasswd, pdbedit, smbstatus, smbcontrol).
Requires: samba
Requires: samba-common-tools
# setfacl, which sharing a folder with several users needs
Recommends: acl
# answers the WS-Discovery queries that make the server visible in
# Windows' Network view
Recommends: wsdd
# advertises the server over mDNS, which is how macOS machines find it
# by name on the network
Suggests: avahi

%{NPM_PROVIDES}

%description
Cockpit module for managing Samba file shares: create and edit shares,
manage Samba access and passwords for local accounts, edit the global
Samba configuration, and detect and fix missing share directories and
incorrect SELinux contexts.

%prep
%autosetup -n %{name}
%if %{defined rebuild_bundle}
%setup -q -D -T -a 1 -n %{name}
%endif

%build
%if %{defined rebuild_bundle}
rm -rf dist
# HACK: node module packaging is broken in Fedora ≤ 43; should be in
# common location, not major version specific one
NODE_ENV=production NODE_PATH=/usr/lib/node_modules:$(echo /usr/lib/node_modules_*) ./build.js
%else
# Use pre-built bundle on distributions without nodejs-esbuild
%endif


%install
%make_install PREFIX=/usr

# drop source maps, they are large and just for debugging
find %{buildroot}%{_datadir}/cockpit/ -name '*.map' | xargs --no-run-if-empty rm --verbose

%check
appstream-util validate-relax --nonet %{buildroot}/%{_datadir}/metainfo/*

# The page cannot be meaningfully exercised during a package build; the
# browser tests need a running VM (`make check` in the source tree).

%files
%doc README.md
%license LICENSE dist/index.js.LEGAL.txt
%{_datadir}/cockpit/*
%{_datadir}/metainfo/*

%changelog
